# JobMarket Intelligence — Environment Variables Template
# Copy this file to .env and adjust if needed

# Hadoop HDFS Cluster
HADOOP_HOME=C:\bigdata\hadoop
HADOOP_CONF_DIR=C:\bigdata\hadoop\etc\hadoop
HDFS_NAMENODE_URI=hdfs://localhost:9000
HDFS_REPLICATION_FACTOR=3

# Java & Spark
JAVA_HOME=C:\bigdata\java
SPARK_HOME=C:\bigdata\spark
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=2g
SPARK_SQL_SHUFFLE_PARTITIONS=8

# Backend Serving API (FastAPI)
API_HOST=127.0.0.1
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite + React)
VITE_API_URL=http://127.0.0.1:8000

# Airflow
AIRFLOW_HOME=C:\bigdata\airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
